<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-01-create-orders" author="luxora">
        <createTable tableName="orders">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints foreignKeyName="fk_orders_user" references="users(id)"/>
            </column>
            <column name="status" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="recipient_name" type="VARCHAR(160)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="address_line1" type="VARCHAR(240)">
                <constraints nullable="false"/>
            </column>
            <column name="address_line2" type="VARCHAR(240)"/>
            <column name="city" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="province" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="country" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="postal_code" type="VARCHAR(24)"/>
            <column name="subtotal" type="DECIMAL(12, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="shipping_fee" type="DECIMAL(12, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="tax" type="DECIMAL(12, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="discount" type="DECIMAL(12, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="grand_total" type="DECIMAL(12, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetimeoffset(7)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="orders" indexName="idx_orders_user_created_at">
            <column name="user_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="004-02-create-order-items" author="luxora">
        <createTable tableName="order_items">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_order_items_order" references="orders(id)" deleteCascade="true"/>
            </column>
            <column name="product_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="variant_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="product_slug" type="VARCHAR(220)">
                <constraints nullable="false"/>
            </column>
            <column name="product_name" type="VARCHAR(180)">
                <constraints nullable="false"/>
            </column>
            <column name="variant_name" type="VARCHAR(180)"/>
            <column name="sku" type="VARCHAR(80)">
                <constraints nullable="false"/>
            </column>
            <column name="color" type="VARCHAR(80)"/>
            <column name="storage" type="VARCHAR(80)"/>
            <column name="image_url" type="VARCHAR(500)"/>
            <column name="unit_price" type="DECIMAL(12, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="line_total" type="DECIMAL(12, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetimeoffset(7)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="order_items" indexName="idx_order_items_order">
            <column name="order_id"/>
        </createIndex>
        <createIndex tableName="order_items" indexName="idx_order_items_variant">
            <column name="variant_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
