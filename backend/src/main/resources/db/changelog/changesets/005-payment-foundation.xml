<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005-01-create-payments" author="luxora">
        <createTable tableName="payments">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_payments_order" references="orders(id)"/>
            </column>
            <column name="provider" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="provider_reference" type="VARCHAR(120)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="amount" type="DECIMAL(12, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetimeoffset(7)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="datetimeoffset(7)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="payments" indexName="idx_payments_order_created_at">
            <column name="order_id"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="payments" indexName="idx_payments_order_status">
            <column name="order_id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
