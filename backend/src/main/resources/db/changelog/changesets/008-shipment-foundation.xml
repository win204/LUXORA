<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="008-01-create-shipments" author="luxora">
        <createTable tableName="shipments">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="UUID">
                <constraints nullable="false" unique="true" foreignKeyName="fk_shipments_order" references="orders(id)"/>
            </column>
            <column name="carrier" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="tracking_number" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="shipped_at" type="datetimeoffset(7)">
                <constraints nullable="false"/>
            </column>
            <column name="delivered_at" type="datetimeoffset(7)"/>
            <column name="created_at" type="datetimeoffset(7)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="datetimeoffset(7)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="shipments" indexName="idx_shipments_tracking_number">
            <column name="tracking_number"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
