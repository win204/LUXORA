<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="006-01-create-order-status-history" author="luxora">
        <createTable tableName="order_status_history">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_order_status_history_order" references="orders(id)" deleteCascade="true"/>
            </column>
            <column name="from_status" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="to_status" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="changed_at" type="datetimeoffset(7)">
                <constraints nullable="false"/>
            </column>
            <column name="changed_by_user_id" type="UUID">
                <constraints foreignKeyName="fk_order_status_history_user" references="users(id)"/>
            </column>
        </createTable>

        <createIndex tableName="order_status_history" indexName="idx_order_status_history_order_changed_at">
            <column name="order_id"/>
            <column name="changed_at"/>
        </createIndex>
        <createIndex tableName="order_status_history" indexName="idx_order_status_history_changed_by">
            <column name="changed_by_user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
